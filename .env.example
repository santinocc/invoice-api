# Copy to .env and adjust. The server reads these from the environment.
PORT=8080

# Leave DATABASE_URL unset to keep invoices in memory.
# This value matches docker-compose.yml (local development only).
DATABASE_URL=postgres://invoice:invoice@localhost:5432/invoice?sslmode=disable

# Only for `go test`: the Postgres tests EMPTY this database before each test.
# Never point it at a database whose data you want to keep.
# Leave it unset and those tests are skipped.
TEST_DATABASE_URL=postgres://invoice:invoice@localhost:5432/invoice_test?sslmode=disable
